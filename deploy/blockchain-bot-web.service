[Unit]
Description=BlockChain-Bot Dashboard (Next.js)
Documentation=https://github.com/manojdevopseng/BlockChain-Bot-Monitor
After=network-online.target blockchain-bot-api.service
Wants=network-online.target

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/BlockChain-Bot-Monitor/frontend
Environment=NODE_ENV=production
# The browser talks to nginx on the same origin, so the API base is relative.
# next.config.js rewrites /api/* to the backend during `next start` too.
Environment=NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
ExecStart=/usr/bin/npm run start -- --port 3000 --hostname 127.0.0.1

Restart=always
RestartSec=5
StartLimitIntervalSec=0

TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bcbot-web

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
