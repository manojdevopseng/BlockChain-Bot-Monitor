# =============================================================================
#  BlockChain-Bot — environment template
# =============================================================================
#  Copy this file to `.env` and fill in the values:   cp .env.example .env
#  This template intentionally contains NO values — never put real keys,
#  tokens, cookies or chat IDs here (this file is meant to be committed).
#  Every variable below is documented: what it is, and where to get it.
# =============================================================================


# ─── SERVER ───────────────────────────────────────────────────────────────────

# Interface uvicorn binds to. 0.0.0.0 = all interfaces (needed on EC2).
API_HOST=
# Port the FastAPI backend listens on. Default: 8000
API_PORT=
# Comma-separated origins allowed by CORS — the URLs the dashboard is served
# from. Local dev: http://localhost:3000,http://127.0.0.1:3000
# On EC2 use your domain, e.g. https://bot.yourdomain.com
CORS_ORIGINS=


# ─── DATABASE ─────────────────────────────────────────────────────────────────

# MongoDB connection string. Local/EC2 default: mongodb://localhost:27017
MONGO_URI=
# Database name inside MongoDB. Default: blockchain_bot
MONGO_DB=


# ─── DATA RETENTION (days) ────────────────────────────────────────────────────
# Enforced by MongoDB TTL indexes: mongod deletes expired documents in its own
# background sweep (~every 60s), so the app itself does zero cleanup work.
# This is what keeps disk/CPU low on EC2.  0 = keep forever (not recommended).

# Scanner/system logs. 15 = a log written on day 1 disappears when day 16 starts.
LOG_RETENTION_DAYS=
# Alerts + high-gas buys. Also bounds the Alerts History dropdown. Default: 15
ALERT_RETENTION_DAYS=
# Discovered tokens. Default: 30
TOKEN_RETENTION_DAYS=
# Daily premium-detection archives (History dropdown). Default: 15
ARCHIVE_RETENTION_DAYS=
# Second Dashboard — one row per call. Far more rows than the merged panel
# keeps, so it has its own window. Default: 30
CALLS_RETENTION_DAYS=
# The pictures those calls arrived with. The heaviest thing the app stores, so
# they age out well before the text they came with. Default: 7
CALLS_MEDIA_RETENTION_DAYS=


# ─── DASHBOARD LOGIN (JWT) ────────────────────────────────────────────────────

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=
# How long a login stays valid, in minutes. Default: 1440 (24h)
JWT_EXPIRE_MINUTES=
# Username for the dashboard login.
ADMIN_USERNAME=
# Password for the dashboard login. CHANGE THIS before deploying.
ADMIN_PASSWORD=

# The read-only account. It sees every page and can change nothing: Forwarder,
# Commands and Settings are closed to it, and any request that is not a read is
# refused whatever page it comes from. Leave both blank and the account does not
# exist — only the admin can log in.
USER_USERNAME=
USER_PASSWORD=


# ─── GMGN ─────────────────────────────────────────────────────────────────────
# The fingerprint values below expire every so often. When GMGN starts returning
# 401/403, refresh them from your logged-in gmgn.ai browser session — or paste
# the new values in the dashboard: Settings → GMGN Credentials (writes here).

# API key from https://gmgn.ai/ai — used for the authenticated openapi surface.
GMGN_API_KEY=
# Web client id, looks like: gmgn_web_YYYYMMDD-nnnn-xxxxxxx
GMGN_CLIENT_ID=
# Browser device id (UUID) from the same session.
GMGN_DEVICE_ID=
# Browser fingerprint id (fp_did) from the same session.
GMGN_FP_DID=
# Cloudflare clearance cookie (cf_clearance). Optional — only needed if GMGN
# starts challenging requests from your server's IP.
CF_CLEARANCE=
# Browser profile curl_cffi impersonates. gmgn.ai fingerprints the TLS
# handshake, not just the headers: plain HTTP clients and older Chrome profiles
# get a flat 403 ("Sorry, you have been blocked") no matter what headers or
# cookies you send — a current profile passes straight through.
# Verified working: chrome136 (6/6), chrome133a, safari184
# Verified blocked: chrome120, chrome124, chrome131, firefox135, plain aiohttp
# Bump this when Cloudflare tightens again — `pip index versions curl_cffi`
# then check curl_cffi's supported list. Default: chrome136
GMGN_IMPERSONATE=


# ─── GMGN REQUEST PACING & RETRIES ────────────────────────────────────────────
# Tune these if GMGN starts rate-limiting (403/429) or calls time out.
# The rate limiter holds its lock during the wait, so calls are spaced exactly.

# Pace of the shared scanning client, in requests/second. This is the one that
# matters — gmgn.ai's Cloudflare 403s a datacenter IP that polls too fast.
# Lower = safer/slower. Default: 0.4 (one request every 2.5s)
GMGN_SCAN_RATE=
# Fallback pace for any GMGN client created without an explicit rate.
# Default: 1.5
API_RATE_LIMIT=
# Attempts per GMGN call before giving up. Default: 3
RETRY_MAX=
# Exponential backoff base in seconds: 2 → 4 → 8. A Cloudflare 403/429 instead
# waits a fixed 30s and then resets the backoff. Default: 2.0
RETRY_BACKOFF_BASE=


# ─── SOLANA SCANNER THRESHOLDS ────────────────────────────────────────────────
# A token from a whitelisted launchpad (pump.fun / bonk / bonkers / bags) starts
# its watch window only when BOTH the market-cap and fee thresholds are met.
# While a ticker is watched, a matching new pair on ETH/RBH fires a cross-chain
# alert. Loosen these to catch more tokens, tighten to cut noise.

# Seconds between GMGN new-pair scans. Default: 5
SOL_SCAN_INTERVAL=
# Minimum market cap in USD to trigger. Default: 40000
SOL_MIN_MCAP=
# Minimum total fees in SOL to trigger. Default: 1.0
SOL_MIN_FEES=
# How long a triggered ticker stays watched, in minutes. Default: 360 (6h)
SOL_WATCH_WINDOW=


# ─── ETH GAS FEES (high-gas early buy detection) ──────────────────────────────
# Every new Uniswap V2/V4 pair on ETH is watched. Each BUY's gas fee is read
# from its receipt (gasUsed × effectiveGasPrice). A buy paying MIN_FEE_ETH or
# more means someone is sniping/front-running — that fires the alert to
# GAS_ALERT_CHAT_ID once, and the token stops being watched.
# Controlled live by the "ETH Gas Fees" toggle in Settings → Bots.

# Gas fee (in ETH) that a single buy must pay to trigger the alert.
# Lower = more alerts. Default: 0.0009 (same as the reference bot)
MIN_FEE_ETH=
# Hard cap on how long one token is watched, from detection. Default: 14400 (4h)
MONITOR_WINDOW_SECONDS=
# Shorter window started by the FIRST buy. Whichever timer expires first stops
# the watch. Default: 1800 (30 min)
FIRST_BUY_WINDOW_SECONDS=
# Max tokens watched at once — each holds a live WS subscription. Default: 150
MAX_GAS_MONITORS=


# On-chain discovery: watch a launchpad's own program for new mints instead of
# relying on GMGN's rolling 500-pair feed, which drops older pairs and leaves
# the launchpad label empty on some of them. Needs SOL_RPC_WSS. One id per
# launchpad; blank = that launchpad is not watched on-chain and keeps arriving
# through the GMGN feed exactly as before. Measured on Helius: ~60 messages/sec
# for pump.fun (mostly swaps), ~10 real launches a minute — check your
# provider's pricing before enabling more of them.
# (The endpoints themselves, including the failover slot, live in the RPC
# ENDPOINTS section below — this is only the list of programs to watch.)

SOL_PUMP_PROGRAM=
SOL_BONK_PROGRAM=
SOL_BONKERS_PROGRAM=
SOL_BAGS_PROGRAM=

# ─── AI NARRATIVE AGENT (Robinhood) ───────────────────────────────────────────
# Reads each new Robinhood token's X link, checks the account is verified, and
# asks Grok whether it matches a watched narrative. Off unless the Settings →
# Bots → "AI Narrative Agent" switch is on AND a key is set here.
# Key from https://console.x.ai — needs credits on the team.
XAI_API_KEY=
XAI_BASE_URL=
# The narrative pass — one label out of sixteen, on every launch that clears
# the gates. This is the call that costs money. Blank = grok-4.3.
XAI_MODEL=
# Fact check — asked about one token when somebody presses the button, so a
# reasoning model is affordable here in a way it is not above.
# Blank = grok-4.20-reasoning.
XAI_FACT_MODEL=
# Seconds between passes over the Robinhood new-pairs feed. Default: 60
AI_SCAN_INTERVAL=
# true = decide and record, but send nothing. Leave it on for the first day and
# read AI Narrative in the dashboard before letting it post. Default: true
AI_DRY_RUN=
# Verdict confidence needed to notify (1-10). Default: 7
AI_MIN_CONFIDENCE=
# Which kinds of verified account count. Paid blue is `individual` — drop it
# if blue-tick spam gets through. Default: government,business,individual
AI_VERIFIED_TYPES=
# Where AI notifications go. Blank = ROBINHOOD_CHAT_ID.
AI_CHAT_ID=
# The realtime launch feed. Every pump.fun launch arrives here with its metadata
# URI, so the X link comes with the token rather than a minute later. No API key
# needed for `subscribeNewToken`.
# Default: wss://pumpportal.fun/api/data
PUMPPORTAL_WS=

# The Telegram rule, and only this — the model's own gate does not count
# launches. A link carrying AI_LINK_BURST_COUNT launches inside
# AI_LINK_BURST_WINDOW seconds is a coordinated push whatever names they went
# out under, and one of those that then runs is what is worth a message.
# Counted per IST day. Defaults: 5 launches / 300 seconds
AI_LINK_BURST_COUNT=
AI_LINK_BURST_WINDOW=
# One of those launches is watched for its market cap this long after it opens,
# and crossing this many dollars inside that window is what puts it in front of
# a person. Measured live: a launch opens at ~28 SOL, so at $74 SOL the $8k bar
# is about a 4x inside the first minute. Both editable live from Settings → AI.
# Defaults: 60 seconds / 8000 dollars
AI_MCAP_WATCH_SECONDS=
AI_TELEGRAM_MCAP_USD=

# ─── DAILY DIGEST ─────────────────────────────────────────────────────────────
# One summary message a day to ALERT_CHAT_ID: what fired in 24h, how the alerts
# performed, and the best premium groups. true/false. Default: true
DIGEST_ENABLED=
# IST hour to send it (0-23). Default: 9
DIGEST_HOUR=

# ─── HEALTH WATCHDOG ──────────────────────────────────────────────────────────

# Alert when a chain's WebSocket stays disconnected. true/false. Default: true
HEALTH_ALERT_ENABLED=
# How long it must stay down before alerting, in seconds. Default: 300 (5 min)
HEALTH_DOWN_SECONDS=


# ─── RPC ENDPOINTS ────────────────────────────────────────────────────────────
# WSS carries live detection (a persistent subscription); HTTP is for one-off
# reads — tx receipts and contract lookups. Use a paid provider (Alchemy,
# Infura, Helius) — public endpoints rate-limit quickly.
#
# Every _FALLBACK is optional and blank = no failover. On a rejection the pool
# rotates to the next endpoint and wraps back to the first, so a provider having
# a bad hour costs one reconnect instead of the whole feature. Two things worth
# knowing before filling them in:
#   • A second URL on the SAME provider account shares that account's quota and
#     dies with it. Use a different account, ideally a different provider.
#   • These are all editable live from the dashboard (RPC Monitor → per-chain
#     cards), so a dead provider can be replaced without an SSH session.

# ── Ethereum ──
# Discovery (SOL→ETH new-pair detection). Rotates 1 → 2 → 3 → 1.
ETH_RPC_WSS=
ETH_RPC_WSS_FALLBACK=
ETH_RPC_WSS_FALLBACK2=
# A different job on the same chain: the premium-caller capture's eth_getCode +
# token-metadata reads (Settings → Bots → Premium ETH).
ETH_RPC_HTTP=
ETH_RPC_HTTP_FALLBACK=
# A third job: ETH Gas Fees. It holds one subscription per watched pair and
# reads a receipt for every buy, so sharing a key with new-pair detection can
# starve it of compute units. Blank = share ETH_RPC_* above.
GAS_RPC_WSS=
# A second provider for the gas socket. It had none, so a rate-limited key
# meant retrying the one refused URL every 60 seconds while ETH and Robinhood
# rotated past theirs. Use a different provider, not another URL on the same
# account — the quota is per account.
GAS_RPC_WSS_FALLBACK=
GAS_RPC_HTTP=

# ── Robinhood Chain (chain 4663) ──
# Discovery (SOL→RBH new-pair detection). Rotates 1 → 2 → 3 → 1.
RBH_RPC_WSS=
RBH_RPC_WSS_FALLBACK=
RBH_RPC_WSS_FALLBACK2=
# Premium-caller capture (Settings → Bots → Premium RBH).
RBH_RPC_HTTP=
RBH_RPC_HTTP_FALLBACK=

# ── BNB Chain (BSC) ──
# Premium-caller detection only — there is no BNB discovery scanner, so there is
# no WSS pair here. An 0x address seen in a premium group is checked against BSC
# the same way it is checked against Ethereum. Both blank = BNB detection off.
BNB_RPC_HTTP=
BNB_RPC_HTTP_FALLBACK=
# WBNB — the base token a BSC pair is priced against, used to work out which
# side of a pair is the actual token.
# Default: 0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
BNB_WBNB=

# ── Base ──
# Premium-caller detection only, exactly like BNB above: no discovery scanner
# and no WSS pair. Two slots — the second is the backup the pool falls to when
# the first stops answering, so a public endpoint going quiet does not take the
# chain off the board. Both blank = Base detection off.
# Defaults are public and rate-limited; replace them with your own provider's
# endpoints when the volume justifies it.
# Default: https://mainnet.base.org
BASE_RPC_HTTP=
# Default: https://base.llamarpc.com
BASE_RPC_HTTP_FALLBACK=
# WETH on Base — the base token a Base pair is priced against, used to work out
# which side of a pair is the actual token.
# Default: 0x4200000000000000000000000000000000000006
BASE_WETH=

# ── Solana ──
# On-chain launch discovery AND the trade stream the market-cap watch reads, so
# losing both endpoints also stops anything reaching the Telegram filter. MUST
# support `logsSubscribe`: Alchemy's Solana endpoint answers "Method
# 'logsSubscribe' not found" (tested), so use Helius, QuickNode or Triton. Two
# slots, not three — that list of providers is much shorter than for plain
# JSON-RPC.
SOL_RPC_WSS=
SOL_RPC_WSS_FALLBACK=
# Unrelated to discovery: a single getAccountInfo check confirming a Solana
# address seen in a premium group is a real account (Settings → Bots →
# Premium SOL). Any provider will do; Alchemy is fine here.
SOL_RPC_HTTP=
SOL_RPC_HTTP_FALLBACK=


# ─── TELEGRAM ACCOUNTS ────────────────────────────────────────────────────────

# Bot token from @BotFather. Used for alerts (start/stop/restart/errors),
# cross-chain notifications, and the /command handler (/status, /alerts, …).
# Without it those messages are only logged and the bot answers no commands.
TELEGRAM_BOT_TOKEN=
# Your personal Telegram user id (get it from @userinfobot) — fallback chat.
TELEGRAM_CHAT_ID=
# Userbot credentials from https://my.telegram.org (API development tools).
# Required for the Forwarder: it reads your premium groups as your account.
TELETHON_API_ID=
TELETHON_API_HASH=
# Name of the Telethon session file (without .session). The file itself must be
# copied to the server — otherwise the userbot asks for a login code. Default:
# final_session
TELETHON_SESSION=


# ─── TELEGRAM CHAT IDs ────────────────────────────────────────────────────────
# All of these are YOUR groups — nothing is hardcoded in the code.
# Leave any of them blank to disable that route (it is skipped, not an error).
# Tip: add @userinfobot to a group to read its chat id (starts with -100…).

# ⭐ BlockChainBot group — operational alerts land here:
#    🟢 bot STARTED · 🔴 bot STOPPED · 🔁 bot RESTARTED (after a crash/reboot)
#    ⚠️ any ERROR from a scanner (same error repeats are suppressed)
ALERT_CHAT_ID=
# 🚨 "High Gas Early Activity" alerts (the ETH Gas Fees feature).
GAS_ALERT_CHAT_ID=
# SOL→ETH cross-chain ticker matches.
CROSS_CHAIN_CHAT_ID=
# SOL→Robinhood cross-chain ticker matches.
ROBINHOOD_CHAT_ID=
# WebSocket/RPC down warnings. Falls back to CROSS_CHAIN_CHAT_ID if blank.
HEALTH_CHAT_ID=

# 💬 The ONE group the bot answers /commands in. Anywhere else it stays
#    silent and shows no "/" menu. Blank = same group as ALERT_CHAT_ID.
COMMAND_CHAT_ID=

# ── Forwarder destinations (where filtered signals are forwarded) ──
# Otto deployments (method/function hash matches).
DEST_OTTO=
# Main signals — CallAnalyser2 first-calls + BuyBotTracker new groups.
DEST_SIGNALS=
# DEX signals from dexssignal.
DEST_DEXS=
# Raw mirror — every premium group message is copied here (highest volume).
DEST_PREMIUM_ALL=

# Premium-caller detections, one group per chain. An address found in a premium
# group is announced only in the group of the chain it is actually live on, so
# the same 0x string being a contract on two chains posts in both and never in
# the wrong one. Sent by the BOT (the bot is not in the source groups, so it
# composes the message rather than forwarding it). Max 2 calls per address per
# chain. Blank = that chain is recorded in the dashboard panel and not sent.
DEST_PREMIUM_ETH=
DEST_PREMIUM_RBH=
DEST_PREMIUM_BNB=
DEST_PREMIUM_SOL=

# Important Caller — the filtered read of the premium feed. Callers starred in
# Forwarder → Premium Groups have their messages forwarded here as well as to
# DEST_PREMIUM_ALL, which keeps carrying everything. Forwarded by the userbot,
# so it has to be a member of this group. Blank = the feature is off.
DEST_IMPORTANT_CALLER=

# ── Robinhood — X — Token Monitor ──
# Reads a Robinhood launchpad token's own metadata() string off the chain and
# records the X account behind it. Only @username links — a link to one post
# says nothing about who is behind the launch.
#
# Its own three WebSocket slots so its quota is its own. Leave them blank and
# it borrows the Robinhood Chain endpoints above, which is how it runs until
# you set them (RPC Monitor → Robinhood — X — Token Monitor).
RBHX_RPC_WSS=
RBHX_RPC_WSS_FALLBACK=
RBHX_RPC_WSS_FALLBACK2=
# Where detections are posted. Blank = recorded in the panel, not sent.
DEST_RBH_X_MONITOR=
# Launchpad alerts whose bio matched a keyword go here instead, so the loud
# feed and the interesting one are not the same chat. Blank = they stay with
# everything else above.
DEST_RBH_KEYWORD_MATCH=
# Where "all its endpoints are refusing" goes — this feed's own health chat,
# not the general alert group.
RBHX_ALERT_CHAT_ID=
# Rows, skip entries and watch entries are dropped this many days after they land.
RBHX_RETENTION_DAYS=15

# Launchpads to watch for a brand-new token, so a launch is seen when it is
# minted rather than when it graduates to a Uniswap pool. Two real tokens were
# measured at 1h 04m and 3h 33m behind on the pool signal alone, and one that
# never graduates would never be seen at all.
#
#   address:topic0:where , address:topic0:where , …
#
# `where` says which part of the event carries the new token's address:
#   t<N> = topic N   d<N> = data word N
# Every launchpad shapes its event differently; all three below were read off
# real creation receipts. Blank = watch pool creation only.
#   0xa5aab3f0… Pons     0x26605f32… (proxy)     0x000000e2… Trendor
RBHX_LAUNCHPADS=

# Skip a launch whose own deployer buys more than this much of it, in the
# chain's native ETH. The dev wallet is read from the same signed blob the X
# handle comes from, so this only applies to launches that carry one — and
# only to that wallet, not to a fresh one funded on the side. 0 = keep all.
RBHX_DEV_BUY_MAX_ETH=3
# How long after a launch that wallet is watched. First trades on a measured
# launch came at +30s; the row is on the page from the first second either way
# and is taken off if the limit is passed.
RBHX_DEV_BUY_WINDOW=180
# The other end of that number: above this the deployer has put real money
# into their own launch, so the row is highlighted on the page and the Telegram
# alert carries a 🟢 Strong Signal line. 0 = do not mark any of them.
RBHX_DEV_BUY_STRONG_ETH=0.199

# ── Robinhood Launchpad Monitor ──
# Every launch from these launchpads, with or without an X profile. Fed by the
# same worker and the same socket as the X monitor above — no extra RPC.
#
# Only addresses live here. Each launchpad's event shape and how to read its
# socials are in app/scanners/launchpads/<name>.py, because every one of them
# does it differently.
#
# Pons — docs.ponsfamily.com → Launches. Active factory first, then legacy;
# tokens from both are Pons and share one filter tab. These are the v1 docs'
# two factories, not v1-and-v2 — v2 is the separate deployment below.
PONS_FACTORIES=
# Pons v2 — docs.ponsfamily.com/docs/v2 → Factory. Its own contracts and its
# own TokenLaunched event, so its own filter tab next to Pons.
PONS_V2_FACTORIES=
# Flap — docs.flap.sh → deployed contract addresses. The Portal mints both the
# standard and the tax token implementation.
FLAP_PORTALS=
# Pools.trade — Uniswap's liquidity launchpad. Its LiquidityLauncher launches
# straight into a Uniswap pool, so these tokens never sit on a curve. There is
# more than one launcher live, hence the list.
POOLS_FACTORIES=
# The UERC20 token factory every launcher mints through. Watched as well so a
# launcher that is not in the list above is still caught.
POOLS_TOKEN_FACTORIES=
# Virtuals Protocol — whitepaper.virtuals.io. One launcher proxy; its socials
# are not on chain at all, they come from Virtuals' own API keyed by the token.
VIRTUALS_FACTORIES=
# LetsCash — letscash.fun. Its docs print "n/a" for every contract; the address
# below is what the site's own config serves (api.letscash.fun/api/config,
# contracts.launchpadFactory). Tokens answer socials() like Pons.
LETSCASH_FACTORIES=
# Rows are dropped this many days after they land.
LAUNCHPAD_RETENTION_DAYS=15


# ─── TELEGRAM SENDING LIMITS ──────────────────────────────────────────────────

# The same error is re-sent to ALERT_CHAT_ID at most once per this many seconds,
# so a scanner failing in a loop cannot flood the group. Default: 900 (15 min)
ERROR_ALERT_COOLDOWN=
# Same idea for the log itself: an identical WARNING/ERROR is stored at most
# once per this many seconds, and the repeats are counted and shown on the next
# write ("+119 repeats in 5m"). Keeps MongoDB small when a scanner fails in a
# loop. INFO/DEBUG are never throttled. 0 = off. Default: 300 (5 min)
LOG_DEDUP_SECONDS=
# Max messages per minute per destination chat. Telegram's own limit for groups
# is about 20/min; staying under it avoids FloodWait bans. Default: 18
TG_MAX_PER_MINUTE=


# ─── FORWARDER SOURCE CHANNELS ────────────────────────────────────────────────
# Telegram usernames the userbot listens to (no @). Change only if you follow
# different channels. Defaults: CallAnalyser2 / BuyBotTracker / dexssignal /
# OttoEthDeployments

# First-call signals with an ETH address.
SOURCE_CALL=
# "New group added" buybot signals on chain: eth.
SOURCE_BUYBOT=
# DEX signals (ethereum/base).
SOURCE_DEXS=
# Contract deployments matched by method/function hash.
SOURCE_OTTO=


# ─── CHAIN CONTRACTS ──────────────────────────────────────────────────────────
# The factory/pool-manager addresses whose events are watched for new pairs.
# Leave the ETH ones blank to use Uniswap's canonical mainnet addresses (they
# are immutable contracts and have never changed) — fill them only if you want
# to watch a different deployment, a fork, or a testnet.

# Ethereum — blank = Uniswap mainnet defaults:
#   V2 factory      0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f
#   V3 factory      0x1F98431c8aD98523631AE4a59f267346ea31F984
#   V4 PoolManager  0x000000000004444c5dc75cB358380D2e3dE08A90
#   WETH            0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
ETH_V2_FACTORY=
ETH_V3_FACTORY=
ETH_V4_POOLMANAGER=
ETH_WETH=

# Robinhood Chain — required for SOL→RBH on-chain detection.
RBH_V2_FACTORY=
RBH_V3_FACTORY=
RBH_V4_POOLMANAGER=
RBH_WETH=
# Token-page link used in Robinhood alerts. `{addr}` is substituted.
# Default: https://robinhoodchain.blockscout.com/token/{addr}
RBH_EXPLORER_TOKEN_URL=
# noxa.fun launchpad — the default RBH detection source (TokenCreated event).
NOXA_FACTORY_ADDRESS=
NOXA_TOKEN_CREATED_TOPIC0=

# ── Which sources the Robinhood detector listens to ───────────────────────────
# Robinhood Chain carries noxa.fun launches AND ordinary Uniswap deployments,
# and a cross-chain match can come from either. Each is a separate WebSocket
# subscription, so they switch independently. Turning one off means tokens
# launched that way are never seen — a watched SOL ticker matching one of them
# can never fire an alert. true/false.
RBH_NOXA_ENABLED=
RBH_V2_ENABLED=
RBH_V3_ENABLED=
RBH_V4_ENABLED=

# ─── MARKET CAP ALERT ─────────────────────────────────────────────────────────

# The section watches the tokens you add and says when one reaches the market
# cap you set for it. Two endpoints per chain, #1 then #2; blank borrows the
# RSI tracker's endpoint for that chain and then the chain's own, so it runs
# before these are filled in.
MCAP_RBH_RPC_HTTP=
MCAP_RBH_RPC_HTTP_FALLBACK=
MCAP_ETH_RPC_HTTP=
MCAP_ETH_RPC_HTTP_FALLBACK=
MCAP_BSC_RPC_HTTP=
MCAP_BSC_RPC_HTTP_FALLBACK=
# Solana is asked for getTokenSupply only — the dollar price comes from
# Jupiter's public API, which needs no key.
MCAP_SOL_RPC_HTTP=
MCAP_SOL_RPC_HTTP_FALLBACK=
# Where market cap alerts go, and where /menu opens this section's screen.
MCAP_ALERT_CHAT_ID=
